{
  "name": "pmuk-mac-recorder",
  "version": "1.4.3",
  "description": "PMUK macOS call recorder with local library and full PMUK call outcome and callback workflow",
  "main": "main.js",
  "author": "PMUK",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pmuk.recorder",
    "productName": "PMUK Recorder",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json"
    ],
    "protocols": [
      {
        "name": "PMUK Recorder",
        "schemes": [
          "pmuk-recorder"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PMUK Recorder needs microphone access to record calls.",
        "NSScreenCaptureUsageDescription": "PMUK Recorder needs screen and system audio access to record calls."
      }
    },
    "dmg": {
      "artifactName": "PMUK-Recorder-${version}-${arch}.${ext}"
    }
  }
}
